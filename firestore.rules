rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /scores/{scoreId} {
      allow read: if true;

      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasOnly(
          ['userId', 'displayName', 'score', 'levelReached', 'timestamp']
        )
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 24
        && request.resource.data.score is int
        && request.resource.data.score >= 0
        && request.resource.data.score < 1000000
        && request.resource.data.levelReached is int
        && request.resource.data.levelReached >= 1
        && request.resource.data.levelReached <= 100;

      allow update, delete: if false;
    }
  }
}
