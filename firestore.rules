rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // One document per player per mode. The mode lives in the path, so it
    // cannot be forged in the payload, each board is a collection of its own
    // (no composite index needed), and a player has exactly one row to read,
    // update or erase.
    match /leaderboards/{mode}/scores/{uid} {
      allow read: if true;

      function validShape() {
        let incoming = request.resource.data;
        return incoming.keys().hasOnly(
            ['userId', 'displayName', 'score', 'levelReached', 'timestamp']
          )
          && incoming.userId == uid
          && incoming.userId == request.auth.uid
          && incoming.displayName is string
          && incoming.displayName.size() > 0
          && incoming.displayName.size() <= 24
          && incoming.score is int
          && incoming.score >= 0
          && incoming.score < 1000000
          && incoming.levelReached is int
          && incoming.levelReached >= 1
          && incoming.levelReached <= 100
          && incoming.timestamp == request.time
          && mode in ['campaign', 'endless', 'daily'];
      }

      allow create: if request.auth != null
        && uid == request.auth.uid
        && validShape();

      // Re-validate the whole document on update, not just the score: without
      // it the bounds checked at creation could be bypassed later, and extra
      // fields could be injected.
      allow update: if request.auth != null
        && uid == request.auth.uid
        && resource.data.userId == request.auth.uid
        && validShape()
        && request.resource.data.score > resource.data.score;

      // The player can erase their own score (right to erasure); nobody else can.
      allow delete: if request.auth != null && uid == request.auth.uid;
    }
  }
}
